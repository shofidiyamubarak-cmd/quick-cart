{
  "compilerOptions": {
    "target": "es2022", // javascript/typescript version
    "module": "nodenext", // tells typescript how to handle imports and exports of packages
    "moduleResolution": "nodenext",
    "rootDir": "src", // tells typescript that all your sources files lives inside src
    "outDir": "dist", // dist simply means distribution
    "types": ["node"], // typescript works with node modules
    "strict": true, // turns on all checks e.g synthax errors etc
    "esModuleInterop": true, // it lets us import packages
    "skipLibCheck": true, // checks for spelling errors
    "forceConsistentCasingInFileNames": true // prevents bugs caused ny case-sensitive file
  },
  "include": ["src"] // tells typescript which file to include in the complimation
}
